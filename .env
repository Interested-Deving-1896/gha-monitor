# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real tokens.

# GitHub Personal Access Token
# Classic PAT scopes: repo, manage_billing:org, read:org
# Fine-grained: org Administration (read) + Actions (read) + billing read
GH_TOKEN=your_github_pat_here

# Default org (optional — can also be passed as --org flag)
# GHA_ORG=my-org
